#
# BK7258 devkit 完整配置 (L0-L5)
# 目标: 系统启动到 NSH 命令行 + 全部外设驱动
#
# 配置层级:
#   L0: 最小 NSH 基线 (时钟/串口/堆/NSH)
#   L1: 存储与文件系统 (Flash/MTD/littlefs)
#   L2: 网络 (WiFi6)
#   L3: 多媒体 (音频DSP/LCD/LVGL)
#   L4: AI 子系统 (AI加速器/TFLite Micro)
#   L5: 完整产品 (BLE/触控/低功耗)
#
# 注意: 初次移植时建议逐级启用, 每级编译验证后再启用下一级。
#

# ===== 架构与板级 =====
CONFIG_ARCH_BOARD_CONTEST2026_092_BOARD=y

# ===== NuttX 基础配置 =====
CONFIG_NUTTX_NEWLIB=y
CONFIG_LIBC_ARCH_ATOMIC=y
CONFIG_NFILE_DESCRIPTORS=16
CONFIG_NBLOCKING_IO=y

# ===== 时钟与定时器 =====
CONFIG_ARCH_TICK_FREQUENCY=1000
CONFIG_USEC_PER_TICK=1000
CONFIG_TIMER=y

# ===== RAM 分配 =====
CONFIG_MM_REGIONS=2
CONFIG_MM_HEAP.Bytes=1048576

# ===== 串口控制台 (NSH) =====
CONFIG_DEV_CONSOLE=y
CONFIG_UART_SERIALDRIVER=y
CONFIG_UART0_SERIAL_CONSOLE=y
CONFIG_UART0_RXBUFSIZE=256
CONFIG_UART0_TXBUFSIZE=256
CONFIG_UART0_BAUD=115200

# ===== NSH =====
CONFIG_NSH=y
CONFIG_NSH_READLINE=y
CONFIG_NSH_PROMPT_STRING="openvela> "
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_DISABLE_MOUNT=n
CONFIG_NSH_DISABLE_ROMFS=n

# ===== 文件系统 =====
CONFIG_FS_PROCFS=y
CONFIG_MTD=y
CONFIG_MTD_PARTITION=y
CONFIG_MTD_SMART=y
CONFIG_FS_SMARTFS=y
CONFIG_SMARTFS_ERASEBLOCKSIZE=4096

# ===== 日志 =====
CONFIG_SYSLOG=y
CONFIG_SYSLOG_CHAR=y
CONFIG_SYSLOG_DEVPATH="/dev/console"

# ===== 内存信息命令 =====
CONFIG_FS_PROCFS_EXCLUDE_MEMINFO=n
CONFIG_FREE=y

# ===== 启动脚本 =====
CONFIG_INIT_ENTRYPOINT="nsh_main"

# ===== L1: 存储与文件系统 =====
CONFIG_BK7258_FLASH=y

# ===== L2: 网络 =====
CONFIG_BK7258_WIFI6=y
CONFIG_NET=y
CONFIG_NET_UDP=y
CONFIG_NET_TCP=y
CONFIG_NET_IPv4=y
CONFIG_NET_DHCP=y
CONFIG_NETUTILS_NETLIB=y

# ===== L3: 多媒体 =====
CONFIG_BK7258_AUDIO_DSP=y
CONFIG_BK7258_AUDIO_CHANNELS=2
CONFIG_BK7258_LCD=y
CONFIG_BK7258_LCD_WIDTH=480
CONFIG_BK7258_LCD_HEIGHT=320
CONFIG_BK7258_2D_ACCEL=y
CONFIG_AUDIO=y
CONFIG_LCD=y
CONFIG_LVGL=y
CONFIG_LV_COLOR_DEPTH=16

# ===== L4: AI 子系统 =====
CONFIG_BK7258_AI_ACCEL=y
CONFIG_BK7258_AI_ACCEL_SRAM_SIZE=128
CONFIG_TFLITE_MICRO=y

# ===== L5: 完整产品 =====
CONFIG_BK7258_BLE54=y
CONFIG_BK7258_PM=y
CONFIG_BK7258_PM_WAKEUP_VOICE=y
CONFIG_BK7258_WDT=y
CONFIG_BK7258_WDT_TIMEOUT=5000
CONFIG_PM=y
CONFIG_WATCHDOG=y
CONFIG_CRYPTO=y
