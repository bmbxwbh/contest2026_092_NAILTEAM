#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_SCENE_AWARE_SPEAKER
	bool "AI Scene-Aware Smart Speaker"
	default n
	depends on AUDIO
	---help---
		Enable the AI scene-aware smart speaker application.
		Supports local voice wake word detection, scene recognition
		via TFLite Micro with sensor fusion, and smart home device
		control simulation on the Gemini-S1 (R528) board.

		All AI inference runs locally on device (no cloud dependency).

if EXAMPLES_SCENE_AWARE_SPEAKER

config SCENE_AWARE_SPEAKER_PRIORITY
	int "Speaker app task priority"
	default 100

config SCENE_AWARE_SPEAKER_STACKSIZE
	int "Speaker app stack size"
	default 8192

config SCENE_AWARE_SPEAKER_AUDIO_DEV_CAPTURE
	string "Audio capture device path"
	default "/dev/audio/pcm0c"

config SCENE_AWARE_SPEAKER_AUDIO_DEV_PLAYBACK
	string "Audio playback device path"
	default "/dev/audio/pcm0p"

config SCENE_AWARE_SPEAKER_SAMPLE_RATE
	int "Audio sample rate (Hz)"
	default 16000

config SCENE_AWARE_SPEAKER_CHANNELS
	int "Number of audio channels"
	default 1

config SCENE_AWARE_SPEAKER_FRAME_SIZE
	int "Audio frame size (bytes)"
	default 640

config SCENE_AWARE_SPEAKER_WAKE_WORD
	string "Wake word string"
	default "ni hao openvela"

config SCENE_AWARE_SPEAKER_SCENE_INTERVAL_MS
	int "Scene detection interval (ms)"
	default 2000

config SCENE_AWARE_SPEAKER_USE_SPEEXDSP
	bool "Use SpeexDSP for audio preprocessing"
	default y
	depends on AUDIOUTILS_SPEEXDSP
	---help---
		Enable SpeexDSP for noise reduction, AGC, and AEC.
		Requires CONFIG_AUDIOUTILS_SPEEXDSP to be enabled.

config SCENE_AWARE_SPEAKER_USE_TFLITE
	bool "Use TFLite Micro for scene detection"
	default n
	---help---
		Enable TFLite Micro for scene classification.
		When disabled, uses rule-based fallback detection.

config SCENE_AWARE_SPEAKER_USE_SENSORS
	bool "Use sensor fusion for scene detection"
	default y
	depends on SENSORS
	---help---
		Fuse sensor data (temperature, humidity, VOC, light)
		with audio features for improved scene detection accuracy.

config SCENE_AWARE_SPEAKER_MIHOME_SIM
	bool "Enable MiHome simulator for demo"
	default y
	---help---
		Simulate MiHome device control actions for demo purposes.
		Outputs control commands to serial log and LVGL UI.

endif
